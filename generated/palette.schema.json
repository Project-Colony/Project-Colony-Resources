{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Project-Colony/Project-Colony-Resources/generated/palette.schema.json",
  "title": "Project Colony theme family",
  "description": "@generated by colony-tokens — DO NOT EDIT. Validates tokens/families/*.toml.",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Stable family key. Must equal the file name."
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "Position in the Settings picker. Unique across families."
    },
    "label_key": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "icon": {
      "type": "string",
      "pattern": "^([0-9a-f]+)?$",
      "description": "Nerd Font codepoint as bare lowercase hex, or empty for none."
    },
    "label": {
      "type": "object",
      "description": "Display string. Both locales are mandatory.",
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "fr",
        "en"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string",
      "description": "Provenance and licensing context for the family."
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "const": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$",
            "description": "Rust const name. Renaming one breaks every consumer that pins it."
          },
          "label_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "mode": {
            "enum": [
              "light",
              "dark"
            ],
            "description": "Must agree with bg_primary's luminance; the generator checks it."
          },
          "label": {
            "type": "object",
            "description": "Display string. Both locales are mandatory.",
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "fr",
              "en"
            ],
            "additionalProperties": false
          },
          "notes": {
            "type": "string",
            "description": "Why this palette looks the way it does."
          },
          "swatch": {
            "type": "object",
            "description": "The two colours drawn on the picker card.",
            "properties": {
              "bg": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              }
            },
            "required": [
              "bg",
              "accent"
            ],
            "additionalProperties": false
          },
          "palette": {
            "type": "object",
            "description": "All 38 palette fields. None may be omitted.",
            "properties": {
              "bg_primary": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$",
                "description": "backgrounds role, exposed to CSS as --colony-bg-primary."
              },
              "bg_sidebar": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$",
                "description": "backgrounds role, exposed to CSS as --colony-bg-sidebar."
              },
